##############################################################################
# OPD Scan QC — example environment file
#
# Copy to .env and edit.  Never commit the real .env.
#
#   cp .env.example .env
#
# Every variable below maps one-to-one onto a field of
# backend/app/config.py (class Settings).  Names are case-insensitive;
# pydantic-settings reads the upper-case form shown here.  Anything absent
# falls back to the default recorded in the comment.
#
# There are NO real secrets in this file.  Placeholders are written as
# CHANGE_ME so that a value accidentally left unedited is obvious.
##############################################################################


# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Display name of the application. Shown in the UI header and in reports.
# Default: OPD Scan QC
APP_NAME=OPD Scan QC

# Deployment tier. One of: dev | staging | prod.
# Default: dev
ENVIRONMENT=dev

# Signing key for the JWT access tokens. Minimum 8 characters; use at least 48
# random characters in production. Rotating it invalidates every issued token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Default: change-me-in-production  (the application must not be run with this)
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# Access-token lifetime in minutes. The default is a 12-hour clinical shift, so
# a clerk is not logged out mid-batch. Shorten it if terminals are shared.
# Default: 720
ACCESS_TOKEN_MINUTES=720

# URL prefix under which the whole API is mounted. The frontend and the nginx
# proxy rule assume /api; changing it means changing both.
# Default: /api
API_PREFIX=/api

# Comma-separated list of browser origins allowed to call the API.
# In the Docker deployment the SPA is served from the same origin as the API,
# so this can usually be left as the dev origin only.
# Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# Database and queue
# ---------------------------------------------------------------------------

# SQLAlchemy URL for PostgreSQL. Inside docker compose the host is the service
# name "postgres"; on a laptop it is localhost.
# Default: postgresql+psycopg://opd:opd@localhost:5432/opd
DATABASE_URL=postgresql+psycopg://opd:CHANGE_ME_DB_PASSWORD@postgres:5432/opd

# Redis URL used as the Celery broker and result backend.
# Default: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# How background work is executed.
#   broker  hand jobs to Redis for a Celery worker to run. The only mode for a real deployment,
#           and what docker-compose.yml starts.
#   inline  run the same jobs on a background thread inside the API process. No Redis and no
#           separate worker needed, so a laptop trial works with nothing but Python and SQLite.
#           Single-threaded and shares CPU with request handling — pilots and demos only.
JOB_EXECUTION=broker


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where originals, renders and thumbnails are kept.
#   local  — a directory on disk (a Docker named volume in the compose setup)
#   s3     — any S3-compatible endpoint, including MinIO on premises
# Default: local
STORAGE_BACKEND=local

# Root directory for the "local" backend. Also used by the "s3" backend as the
# location of its small on-disk read cache, so it must be writable either way.
# Default: ./var/storage
STORAGE_ROOT=/var/lib/opd/storage

# S3 endpoint URL. Leave blank for real AWS S3; set it for MinIO or another
# S3-compatible store, e.g. http://minio:9000
# Default: (unset)
S3_ENDPOINT_URL=

# Bucket that holds patient scans. Required when STORAGE_BACKEND=s3.
# The bucket must be private; nothing in this system serves objects directly.
# Default: (unset)
S3_BUCKET=

# Region name. MinIO ignores it but boto3 still requires a value.
# Default: us-east-1
S3_REGION=us-east-1

# S3 access key ID. Use a credential scoped to this one bucket.
# Default: (unset)
S3_ACCESS_KEY=

# S3 secret access key.
# Default: (unset)
S3_SECRET_KEY=

# Server-side encryption header sent with every upload. AES256 asks the store
# to encrypt objects at rest. Set to "aws:kms" for a customer-managed key, or
# leave blank to send no header (only appropriate when the store encrypts the
# underlying volume itself).
# Default: AES256
S3_SERVER_SIDE_ENCRYPTION=AES256


# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------

# Largest single uploaded file, in megabytes. The customer sample files are
# 10-25 MB each; 200 MB leaves room for a whole scanned case file.
# Default: 200
MAX_UPLOAD_MB=200

# Reject a document with more pages than this. Guards against a mis-scanned
# 10,000-page PDF filling the queue.
# Default: 500
MAX_PAGES_PER_DOCUMENT=500

# Comma-separated list of accepted file extensions, without the dot.
# Default: pdf,jpg,jpeg,png,tif,tiff
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tif,tiff


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

# Rasterisation resolution for PDF pages, in DPI. Higher values give the
# quality engine more to work with and cost proportionally more CPU and disk.
# 150 is the tested value; 200-300 is reasonable for faint pencil work.
# Default: 150
RENDER_DPI=150

# Longest edge of a generated thumbnail, in pixels.
# Default: 320
THUMB_MAX_PX=320

# Longest edge of the bounded preview served to the page viewer, in pixels.
# The full-resolution render is still available on the image route.
# Default: 2000
PREVIEW_MAX_PX=2000


# ---------------------------------------------------------------------------
# AI providers
#
# "none" means the capability is UNCONFIGURED. An unconfigured capability is
# reported as unconfigured throughout the UI and the exports; it is never
# reported as "nothing found". See docs/ONPREM.md.
# ---------------------------------------------------------------------------

# Provider for general OCR, and the source of any provider-side image quality
# signals. One of: none | google_docai | azure_di | local_tesseract
# Default: none
OCR_PROVIDER=none

# Provider for handwriting detection and localisation.
# One of: none | google_docai | azure_di
# local_tesseract is deliberately not an option — Tesseract is a printed-text
# engine and this system will not pretend otherwise.
# Default: none
HANDWRITING_PROVIDER=none

# Provider used for pages where handwritten Devanagari (Hindi) is expected.
# One of: none | azure_di
# Google Document AI does not list handwriting support for Hindi, so azure_di
# is the only permitted value. With "none", handwritten Hindi pages are
# recorded as unsupported rather than as having no handwriting.
# Default: none
HANDWRITING_DEVANAGARI_PROVIDER=none

# Provider used for the diagnosis-extraction stage.
# One of: none | google_docai | azure_di
# Default: none
DIAGNOSIS_PROVIDER=none

# Reasoning provider for prescription understanding (the "medicines, dose, frequency, plain-language
# explanation" feature). This is a SEPARATE capability from OCR_PROVIDER above: OCR_PROVIDER reads
# the pixels into text (Google Document AI does that already); this provider takes that text plus
# the image and interprets it. Prescription analysis is opt-in per page — it does not run on every
# upload the way quality/handwriting/diagnosis do.
# One of: none | gemini
# Default: none
PRESCRIPTION_REASONING_PROVIDER=none

# Google Cloud project that owns the Document AI processor.
# Default: (unset)
GOOGLE_PROJECT_ID=

# Google Document AI processor location, e.g. us | eu | asia1.
# This is the multi-region of the processor, not a compute region. Choose it
# to satisfy your data-residency obligations before creating the processor;
# it cannot be changed afterwards.
# Default: us
GOOGLE_LOCATION=us

# The Enterprise Document OCR processor ID (a hex string from the console).
# Default: (unset)
GOOGLE_PROCESSOR_ID=

# Absolute path INSIDE the container to a service-account JSON key file.
# This is a path, not the key contents. Mount the key read-only; do not bake it
# into an image and do not commit it.
# Default: (unset)
GOOGLE_CREDENTIALS_JSON=/run/secrets/google-docai.json

# Ask Document AI for its image-quality scores and defect list. This is what
# makes Google worth configuring alongside the local engine; turning it off
# leaves quality analysis to OpenCV alone.
# Default: true
GOOGLE_ENABLE_QUALITY_SCORES=true

# Azure AI Document Intelligence endpoint, e.g.
# https://<resource-name>.cognitiveservices.azure.com
# Default: (unset)
AZURE_DI_ENDPOINT=

# Azure AI Document Intelligence key. Treat as a secret; prefer a mounted
# secret file or your orchestrator's secret store over a plain .env on disk.
# Default: (unset)
AZURE_DI_KEY=

# Google Gemini API key (from Google AI Studio — aistudio.google.com/apikey), used only for
# prescription interpretation, never for OCR. Treat as a secret.
# Default: (unset)
GEMINI_API_KEY=

# Gemini model to use for prescription interpretation.
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Per-request timeout for a provider call, in seconds. Also bounds the polling
# loop that waits for an Azure asynchronous analysis to finish.
# Default: 120
PROVIDER_TIMEOUT_SECONDS=120

# Maximum attempts for a provider-backed job before it is recorded as failed.
# Default: 3
PROVIDER_MAX_ATTEMPTS=3

# Client-side token bucket, in requests per minute per worker process. Keep it
# below your vendor quota; multiply by the number of worker processes to get
# the real ceiling.
# Default: 120
PROVIDER_RATE_LIMIT_PER_MINUTE=120


# ---------------------------------------------------------------------------
# Privacy and retention
# ---------------------------------------------------------------------------

# Master switch for sending page images to a cloud service. Off by default and
# deliberately so: enabling it is an explicit deployment decision that should
# be recorded alongside your data-protection assessment. While it is false,
# both cloud providers refuse to run and report themselves as unconfigured,
# whatever credentials are present.
# Default: false
ALLOW_CLOUD_PROCESSING=false

# Permit patient text (OCR output, diagnosis strings, filenames) to reach the
# application log. Intended only for local debugging on synthetic data.
# Must remain false in any environment holding real records.
# Default: false
LOG_PATIENT_TEXT=false

# Delete stored ORIGINAL uploads this many days after upload. 0 keeps them
# indefinitely. Set this to your records-retention policy, not to a guess.
# Default: 0
RETENTION_DAYS_ORIGINALS=0

# Delete derived files (renders, previews, thumbnails) this many days after
# creation. 0 keeps them indefinitely. Derivatives can be regenerated from the
# original, so this can usually be shorter than the originals figure.
# Default: 0
RETENTION_DAYS_DERIVATIVES=0

# Present so that the answer is explicit and auditable rather than implied.
# This codebase contains no training or fine-tuning path. Uploaded patient
# records are not used to train, tune or evaluate any model. Leave it false.
# Default: false
ALLOW_TRAINING_USE=false


##############################################################################
# Compose-only variables
#
# The four below are NOT read by backend/app/config.py. They configure the
# containers in docker-compose.yml and docker-compose.onprem.yml. Keep the
# Postgres values consistent with DATABASE_URL above, and the MinIO values
# consistent with S3_ACCESS_KEY / S3_SECRET_KEY when running the on-prem
# override.
##############################################################################

POSTGRES_USER=opd
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=opd

# MinIO root credentials (docker-compose.onprem.yml only).
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_AT_LEAST_8_CHARS

# Optional compose knobs. Each has a working default in docker-compose.yml, so
# they can be left commented out. Sizing guidance is in docs/DEPLOYMENT.md.

# Host port the application is published on.            Default: 8080
# FRONTEND_PORT=8080

# uvicorn worker processes in the backend container.    Default: 2
# API_WORKERS=2

# Celery prefork children per worker container.         Default: 4
# Local engine only: about one per vCPU. With a cloud provider configured,
# 2-3x vCPU, because most of each task is spent waiting on the network.
# WORKER_CONCURRENCY=4
